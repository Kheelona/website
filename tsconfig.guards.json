{
  // Type-checks what tsconfig.json leaves out: every test, story and harness file (task 1.1, widened
  // by 1.1b item 4). `npm run typecheck` runs it after the app's own check.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-d.ts",
    "src/**/*.test-d.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    // Ambient declarations the app program sees through **/*.ts (static image types for a clean clone,
    // where the git-ignored next-env.d.ts is missing) must be in this program too: a test's subject
    // that imports an .svg or .png type-checks here only with them.
    "src/**/*.d.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  // By name only, never a glob: the legacy and frozen files that do not type-check (2026-10-12).
  // A legacy file's line leaves with the task that deletes or rewrites it; a frozen test stays
  // byte-identical to the tag, so its line stays for good (ruling 2026-10-12). Never add a new file
  // here: test/guards/build-steps.test.ts pins this list to its 2.13 snapshot, so it only shrinks.
  // It fails on a line that names no file, a line the snapshot does not list, a line whose comment
  // does not name the task the snapshot gives it (or "for good", for the four frozen tests only),
  // and a legacy line whose file changed since the freeze tag (a rewritten file must type-check).
  "exclude": [
    "node_modules",
    // Legacy: 6.3 deletes these stories with their components (atoms, organisms, features/home).
    "src/components/atoms/Room.stories.tsx",
    "src/components/atoms/Section.stories.tsx",
    "src/components/organisms/FinaleCTA.stories.tsx",
    "src/components/organisms/ParentQuotes.stories.tsx",
    "src/features/home/components/ParentAppSection.stories.tsx",
    // Legacy: 6.3 retires this guard with its subject.
    "test/action-label.test.ts",
    // Legacy: 6.3 rewrites it (CANONICAL_ORIGIN from @/config/env when seo.ts goes). It fails today
    // (10 errors: allowJs types tools/utm/build-link.mjs, so its @ts-expect-error is unused and the
    // calls miss `content` and `term`).
    "test/utm.test.ts",
    // Frozen checkout test (ADR-013, B3; structure §7): excluded for good. 5.15's literal-only
    // reviewed patch changes no type (9 errors today).
    "src/features/preorder/components/PreorderForm.test.tsx",
    // Frozen guard: excluded for good. 5.11 re-pins its privacy wording only; its PreorderRow
    // fixture lacks ph_distinct_id.
    "test/analytics-tags.test.ts",
    // Frozen with src/lib/email/ (structure §7): excluded for good; 6.4's reviewed diff, if any,
    // changes facts, not types.
    "src/lib/email/templates.test.ts",
    // Frozen with src/features/preorder/lib/ (structure §7; guard-test ownership "Keep"): excluded
    // for good.
    "src/features/preorder/lib/analytics.test.ts"
  ]
}
