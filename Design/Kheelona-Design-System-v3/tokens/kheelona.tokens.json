{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Kheelona design tokens v3.0 — extracted from Kheelona_Brand_Guidelies.fig (August 2026). Machine-readable mirror of kheelona.css.",
  "brand": {
    "name": { "$type": "string", "$value": "Kheelona" },
    "version": { "$type": "string", "$value": "3.0" },
    "guidelinesDate": { "$type": "string", "$value": "2026-08" }
  },
  "color": {
    "primary": {
      "orange": { "$type": "color", "$value": "#EF762F", "$description": "Deep Orange — energy, physical activity. Usage 10%." },
      "yellow": { "$type": "color", "$value": "#F1A23B", "$description": "Golden Yellow — optimism, happiness. Usage 30%." },
      "blue":   { "$type": "color", "$value": "#29A0D7", "$description": "Sky Blue — trust, logic, communication; anchor of the technology side. Usage 20%." },
      "white":  { "$type": "color", "$value": "#FFFFFF", "$description": "White — screen-free clarity. Usage 30%." }
    },
    "secondary": {
      "teal":   { "$type": "color", "$value": "#1ABC9C", "$description": "Cognitive Freshness — the result of using the technology. Usage 5%." },
      "purple": { "$type": "color", "$value": "#8B5BFF", "$description": "Magic Spark — mystery and premium spark. Usage 5%." }
    },
    "ink": {
      "primary":   { "$type": "color", "$value": "#1B1B1B" },
      "secondary": { "$type": "color", "$value": "#44403C" },
      "tertiary":  { "$type": "color", "$value": "#78716C" }
    },
    "surface": {
      "paper": { "$type": "color", "$value": "#FDFEFE" },
      "cream": { "$type": "color", "$value": "#F9F8F6" },
      "line":  { "$type": "color", "$value": "#E7E5E4" }
    },
    "tint": {
      "orange": { "$type": "color", "$value": "#FDEADC" },
      "yellow": { "$type": "color", "$value": "#FCEEDA" },
      "blue":   { "$type": "color", "$value": "#E2F3FA" },
      "teal":   { "$type": "color", "$value": "#DFF7F1" },
      "purple": { "$type": "color", "$value": "#EEE7FF" }
    },
    "usageRatio": {
      "$description": "Colour Usage, guidelines p.23. Warm-first, tech-second.",
      "yellow": { "$type": "number", "$value": 0.30 },
      "white":  { "$type": "number", "$value": 0.30 },
      "blue":   { "$type": "number", "$value": 0.20 },
      "orange": { "$type": "number", "$value": 0.10 },
      "teal":   { "$type": "number", "$value": 0.05 },
      "purple": { "$type": "number", "$value": 0.05 }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Glory", "Baloo 2", "Trebuchet MS", "sans-serif"],
      "$description": "Primary font. Geometric sans with rounded, soft curves — friendly and bouncy, Pixar/Disney aesthetic. Weights: Regular, Medium, SemiBold, Bold."
    },
    "text": {
      "$type": "fontFamily",
      "$value": ["Instrument Sans", "Helvetica Neue", "Arial", "sans-serif"],
      "$description": "Secondary font. Precision neo-grotesque — sharp, modern, highly organized. Weights: Regular, Medium, SemiBold, Bold."
    },
    "editorial": {
      "$type": "fontFamily",
      "$value": ["Instrument Serif", "Georgia", "serif"],
      "$description": "Editorial accent, usually italic — used for section titles in the brand book."
    }
  },
  "typography": {
    "heading": {
      "$description": "Heading Style, guidelines p.18",
      "fontFamily": { "$type": "string", "$value": "{font.display}" },
      "letterSpacing": { "$type": "dimension", "$value": "-0.01em" },
      "lineHeight": { "$type": "number", "$value": 1.2 }
    },
    "paragraph": {
      "$description": "Paragraph Style, guidelines p.19. Reference sizes: heading 36 / body 24.",
      "fontFamily": { "$type": "string", "$value": "{font.text}" },
      "letterSpacing": { "$type": "dimension", "$value": "0.01em" },
      "lineHeight": { "$type": "number", "$value": 1.3 }
    },
    "scale": {
      "hero":    { "$type": "dimension", "$value": "96px" },
      "display": { "$type": "dimension", "$value": "64px" },
      "h1":      { "$type": "dimension", "$value": "48px" },
      "h2":      { "$type": "dimension", "$value": "36px" },
      "h3":      { "$type": "dimension", "$value": "32px" },
      "lead":    { "$type": "dimension", "$value": "24px" },
      "body":    { "$type": "dimension", "$value": "16px" },
      "caption": { "$type": "dimension", "$value": "13px" }
    }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "16px" },
    "lg":   { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sticker": {
      "$type": "shadow",
      "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "4px", "spread": "0px", "color": "rgba(0,0,0,0.25)" },
      "$description": "Logo drop shadow — from Figma spec panel (X0 Y4 blur 4, black 25%)."
    },
    "soft": {
      "$type": "shadow",
      "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "rgba(27,27,27,0.10)" }
    }
  },
  "logo": {
    "wordmarkRatio": { "$type": "number", "$value": 3.594, "$description": "W557 × H155 from Figma spec panel." },
    "clearSpace": { "$type": "string", "$value": "Grid 10 units wide × 3 units tall around the wordmark (construction grid)." },
    "stickerOutline": { "$type": "dimension", "$value": "5px", "$description": "White stroke, outside alignment." },
    "colors": { "$type": "string", "$value": "#29A0D7, #EF762F, #FFFFFF only. Never recolor." }
  }
}
