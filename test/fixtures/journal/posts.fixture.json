      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Children learn to talk by talking with someone who waits for them.[^1]"
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "The waiting is the hard part."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2,
              "anchor": null
            },
            "content": [
              {
                "type": "text",
                "text": "Wait for the reply"
              }
            ]
          },
          {
            "type": "blockquote",
            "attrs": {
              "style": "callout",
              "icon": "question"
            },
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Try this: ",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "name what your child is looking at, then count to five in your head."
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Questions parents ask"
              }
            ]
          },
          {
            "type": "blockquote",
            "attrs": {
              "style": "questions"
            },
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Should I correct every word?"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Say the word back the right way, warmly, and move on."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A conversation is not a test."
                  }
                ]
              },
              {
                "type": "heading",
                "attrs": {
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "text": "What if my child goes quiet?"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Quiet days happen. Keep talking about what you are both doing."
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "type": "text",
                "text": "A note on two languages"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Speak the language you are most at home in."
              }
            ]
          }
        ]
      },
      "metaTitle": null,
      "cardTitle": null,
      "accent": "just starting to speak",
      "lead": "Small habits that keep a first conversation going.",
      "summary": "How to wait, name and keep talking.",
      "answer": {
        "question": "How do you talk with a child who is just starting to speak?",
        "text": "Get down to your child's height, name what they are looking at and then wait, longer than feels natural, for any reply.[^1] A sound, a point or a word all count as a turn. Answer it, add one new word and wait again, so the conversation keeps going back and forth."
      },
