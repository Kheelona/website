    "@PreorderForm amountLabel={amountLabel}",
    "@PreorderForm mode=\"token\"",
    "@PreorderForm balanceLabel={balanceLabel}",
    "@OrderSummary amountLabel={amountLabel}",
    "@OrderSummary tierLabel={result.tier.label}",
    "@OrderSummary mode=\"token\"",
    "@OrderSummary balanceLabel={balanceLabel}",
    "{title}",
    "{message}",
    "@a href=\"/\"",
    "@a href={SUPPORT_WHATSAPP_HREF}"
