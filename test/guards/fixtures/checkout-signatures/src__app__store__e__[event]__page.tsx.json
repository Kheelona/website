{
  "file": "src/app/store/e/[event]/page.tsx",
  "note": "Logic signature (test/guards/checkout-signature.test.ts). Regenerated only with a restyle; every changed line is reviewed (ADR-013).",
  "code": [
    "import Image from \"next/image\";",
    "import { storeEnv } from \"@/lib/store/env\";",
    "import { resolveTier, tierRefusalMessage } from \"@/lib/store/tiers\";",
    "import { PreorderForm, OrderSummary } from \"@/features/preorder\";",
    "import { KHEELU_ART } from \"@/lib/kheelu-art\";",
    "import { formatInr, LAUNCH_AMOUNT_PAISE, LAUNCH_PRICE, SHIP_DATE_TEXT, KHEELU_AGES, SUPPORT_WHATSAPP_HREF, } from \"@/config/site\";",
    "import { NotFoundPanel } from \"../../_components/NotFoundPanel\";",
    "export const dynamic = \"force-dynamic\";",
    "export default async function EventPage({ params, searchParams, }: {",
    "    params: Promise<{",
    "        event: string;",
    "    }>;",
    "    searchParams: Promise<{",
    "        sig?: string;",
    "    }>;",
    "}) {",
    "    const [{ event }, { sig }] = await Promise.all([params, searchParams]);",
    "    const env = storeEnv();",
    "    if (!env)",
    "        return __JSX_NotFoundPanel__;",
    "    const result = await resolveTier(env, { tier: event, signature: sig ?? null });",
    "    if (!result.ok) {",
    "        return (__JSX_div__);",
    "    }",
    "    const amountLabel = formatInr(result.tier.amountPaise);",
    "    const balanceLabel = formatInr(Math.max(0, LAUNCH_AMOUNT_PAISE - result.tier.amountPaise));",
    "    return (__JSX_div__);",
    "}"
  ],
  "jsx": [
    "{tierRefusalMessage(result.reason)}",
    "@a href=\"/\"",
    "@a href={SUPPORT_WHATSAPP_HREF}",
    "{result.tier.label}",
    "{amountLabel}",
    "{KHEELU_AGES}",
    "{amountLabel}",
    "{LAUNCH_PRICE}",
    "{SHIP_DATE_TEXT}",
    "@PreorderForm tier={result.tier.id}",
    "@PreorderForm signature={sig}",
    "@PreorderForm amountLabel={amountLabel}",
    "@PreorderForm mode=\"token\"",
    "@PreorderForm balanceLabel={balanceLabel}",
    "@OrderSummary amountLabel={amountLabel}",
    "@OrderSummary tierLabel={result.tier.label}",
    "@OrderSummary mode=\"token\"",
    "@OrderSummary balanceLabel={balanceLabel}"
  ]
}
