{
  "file": "src/app/store/thanks/page.tsx",
  "note": "Logic signature (test/guards/checkout-signature.test.ts). Regenerated only with a restyle; every changed line is reviewed (ADR-013).",
  "code": [
    "import { cookies } from \"next/headers\";",
    "import { storeEnv } from \"@/lib/store/env\";",
    "import { db } from \"@/lib/store/db\";",
    "import { verifyAddressToken } from \"@/lib/store/signing\";",
    "import { THANKS_COOKIE, parseThanksSession } from \"@/lib/store/thanks-session\";",
    "import { FULL_TIER } from \"@/lib/store/mode\";",
    "import { AddressForm } from \"@/features/preorder\";",
    "import { formatInr, LAUNCH_AMOUNT_PAISE, LAUNCH_PRICE, SHIP_DATE_TEXT, SUPPORT_WHATSAPP_HREF, SUPPORT_WHATSAPP_DISPLAY, } from \"@/config/site\";",
    "import type { PreorderRow } from \"@/lib/store/db\";",
    "import { NotFoundPanel } from \"../_components/NotFoundPanel\";",
    "export const dynamic = \"force-dynamic\";",
    "export default async function ThanksPage() {",
    "    const env = storeEnv();",
    "    const session = parseThanksSession((await cookies()).get(THANKS_COOKIE)?.value);",
    "    if (!env ||",
    "        !session ||",
    "        !verifyAddressToken(env.signingSecret, session.orderRef, session.token)) {",
    "        return __JSX_LinkNeeded__;",
    "    }",
    "    const { data } = await db(env)",
    "        .from(\"preorders\")",
    "        .select(\"*\")",
    "        .eq(\"order_ref\", session.orderRef)",
    "        .maybeSingle();",
    "    if (!data) {",
    "        return (__JSX_NotFoundPanel__);",
    "    }",
    "    const order = data as PreorderRow;",
    "    const paid = order.status === \"paid\";",
    "    return (__JSX_div__);",
    "}",
    "function LinkNeeded() {",
    "    return (__JSX_div__);",
    "}",
    "function Row({ label, value }: {",
    "    label: string;",
    "    value: string;",
    "}) {",
    "    return (__JSX_div__);",
    "}"
  ],
  "jsx": [
    "@NotFoundPanel cta={false}",
    "@div class~ph-mask ph-no-capture",
    "{paid ? \"Pre-order confirmed\" : \"Confirming your payment\"}",
    "{paid ? \"Your Kheelu is reserved.\" : \"Thank you. We are confirming it now.\"}",
    "{paid ? (__JSX_fragment__) : (__JSX_fragment__)}",
    "{formatInr(order.amount_paise)}",
    "{order.email}",
    "@Row value={order.order_ref}",
    "@Row value={formatInr(order.amount_paise)}",
    "{order.tier === FULL_TIER ? (__JSX_Row__) : (__JSX_Row__)}",
    "@Row value=\"Nothing. You have paid in full\"",
    "@Row value={`${formatInr(Math.max(0, LAUNCH_AMOUNT_PAISE - order.amount_paise))}, of the ${LAUNCH_PRICE} price`}",
    "@Row value={SHIP_DATE_TEXT}",
    "{order.address ? \"Your delivery address\" : \"Where should it go?\"}",
    "{order.address ? \"This is where your Kheelu will go. Change it any time before dispatch.\" : \"One last thing, and it takes under a minute. If you would rather do it later, the link in your email brings you straight back here.\"}",
    "@AddressForm orderRef={order.order_ref}",
    "@AddressForm token={session.token}",
    "@AddressForm existing={order.address}",
    "@a href={SUPPORT_WHATSAPP_HREF}",
    "{SUPPORT_WHATSAPP_DISPLAY}",
    "{order.order_ref}",
    "@a href={SUPPORT_WHATSAPP_HREF}",
    "{SUPPORT_WHATSAPP_DISPLAY}",
    "{label}",
    "{value}"
  ]
}
