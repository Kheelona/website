# Copy to .env (or set in Vercel). See FOUNDER-TODO.md at repo root.
#
# GA4 is NOT configured here. The measurement ID is a public client-side
# identifier, so it lives in src/config/site.ts as GA4_MEASUREMENT_ID, where a
# host allowlist keeps it from firing on localhost and preview deploys. The same
# is true of the Ahrefs key. NEXT_PUBLIC_GA4_MEASUREMENT_ID is retired.
#
# Everything below is the OPPOSITE: real secrets, and none of them may ever be
# given a NEXT_PUBLIC_ name. test/store-secrets.test.ts enforces that, because
# the three public identifiers above are a tempting precedent to follow.
#
# Without these the store still deploys: it renders "pre-orders open here
# shortly" and its API routes answer 503. Nothing crashes and no build fails.

# ── Razorpay (dashboard → Settings → API Keys) ───────────────────────────────
# rzp_test_* while verifying, rzp_live_* when the founder flips it.
# /api/health reports which mode is live, so this is checkable from a phone.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Add https://store.kheelona.com/api/razorpay/webhook
# subscribed to order.paid and payment.captured, then paste the secret you set.
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase (Project Settings → API) ───────────────────────────────────────
# The service_role key bypasses RLS and can read every order. Real secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Our own signatures ──────────────────────────────────────────────────────
# Signs event links and address tokens. Any long random string:
#   openssl rand -base64 48
# Changing it invalidates every address link already emailed, so change it only
# on purpose.
STORE_SIGNING_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional. Without it an order is still recorded and the failure is logged,
# because losing an email must never lose an order.
RESEND_API_KEY=
# Must be a domain verified in Resend. send.kheelona.com keeps the main domain's
# deliverability separate from anything transactional.
EMAIL_FROM="Kheelona <hello@send.kheelona.com>"
# Where the internal new-order alert goes. Defaults to hello@kheelona.com.
ORDER_ALERT_EMAIL=

# ── Meta Conversions API (§8.30-l) ───────────────────────────────────────────
# OPTIONAL. Without it the server-side Purchase is skipped and the browser pixel
# carries on alone, which is how the store shipped. A REAL SECRET: it can write
# conversions into the ad account, so it must never take a NEXT_PUBLIC_ name.
# (The Meta PIXEL id is the opposite: public, and hardcoded in config/site.ts.)
# Generate: Events Manager -> dataset -> Settings -> Conversions API ->
# Generate access token. Regenerating there invalidates the old one.
META_CAPI_TOKEN=
# DEVELOPMENT ONLY. Meta's Test Events code, to watch server events arrive while
# building. Never set this in production: it diverts real conversions into the
# test stream, where they do not count.
META_CAPI_TEST_CODE=
