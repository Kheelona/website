    {
      "id": "Q11",
      "what": "In-app browser against paid source (bots excluded; internal not excluded)",
      "hogql": "SELECT coalesce(webview,'(none)') AS in_app, src_group, count() AS sessions, min(toDate(st)) AS first_day, max(toDate(st)) AS last_day, countIf(entry_host = 'store.kheelona.com') AS store_entry, round(avg(pvs),2) AS avg_pv, round(quantile(0.5)(dur),0) AS median_dur_s FROM ( SELECT properties.$session_id AS sid, min(timestamp) AS st, any(session.$entry_hostname) AS entry_host, any(session.$session_duration) AS dur, argMin(properties.$webview_app, timestamp) AS webview, any(session.$entry_referring_domain) AS ref, coalesce(any(session.$entry_utm_source),'') AS us, coalesce(any(session.$entry_utm_medium),'') AS um, coalesce(any(session.$entry_fbclid),'') AS fbc, multiIf(um = 'paid', concat('paid ', us), fbc != '' AND us = '', concat('fbclid only, ref ', coalesce(ref,'')), um = 'social', 'ig bio', 'other') AS src_group, max(properties.$virt_is_bot = true) AS is_bot, countIf(event = '$pageview') AS pvs FROM events WHERE timestamp >= toDateTime('2026-09-19 00:00:00') AND timestamp < toDateTime('2026-10-11 00:00:00') AND event = '$pageview' AND properties.$session_id IS NOT NULL GROUP BY sid HAVING is_bot = 0 ) WHERE src_group != 'other' OR webview IS NOT NULL GROUP BY in_app, src_group ORDER BY sessions DESC LIMIT 40",
