    {
      "id": "Q10",
      "what": "Device, OS, browser and in-app browser of human non-internal sessions (first pageview)",
      "hogql": "SELECT device, os, browser, coalesce(webview,'') AS in_app, count() AS sessions, countIf(paid = 1) AS paid_sessions, countIf(store_pv > 0) AS store_sessions, countIf(form_started > 0) AS form_sessions, countIf(purchased > 0) AS purchases FROM ( SELECT properties.$session_id AS sid, argMin(properties.$device_type, timestamp) AS device, argMin(properties.$os, timestamp) AS os, argMin(properties.$browser, timestamp) AS browser, argMin(properties.$webview_app, timestamp) AS webview, any(session.$entry_referring_domain) AS ref, if(coalesce(any(session.$entry_utm_medium),'') = 'paid' OR (coalesce(any(session.$entry_fbclid),'') != '' AND coalesce(any(session.$entry_utm_source),'') = ''), 1, 0) AS paid, max(properties.$virt_is_bot = true) AS is_bot, countIf(event = '$pageview' AND properties.$host = 'store.kheelona.com' AND properties.$pathname NOT LIKE '/thanks%') AS store_pv, countIf(event = 'preorder_form_started') AS form_started, countIf(event = 'purchase') AS purchased, countIf(event = '$pageview') AS pvs FROM events WHERE timestamp >= toDateTime('2026-09-19 00:00:00') AND timestamp < toDateTime('2026-10-11 00:00:00') AND event IN ('$pageview','preorder_form_started','purchase') AND properties.$session_id IS NOT NULL GROUP BY sid HAVING pvs > 0 AND is_bot = 0 AND NOT (coalesce(ref,'') IN ('localhost:3456','127.0.0.1:3456') OR coalesce(ref,'') LIKE '%vercel.app') ) GROUP BY device, os, browser, in_app ORDER BY sessions DESC LIMIT 60",
