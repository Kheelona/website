    {
      "id": "Q22",
      "what": "Phone and tablet viewport widths (CSS px, first pageview), with median and minimum viewport height",
      "hogql": "SELECT device, vw, count() AS sessions, round(100*count()/sum(count()) OVER (PARTITION BY device), 1) AS pct_of_device, countIf(paid = 0) AS non_paid, round(quantile(0.5)(vh), 0) AS median_vh, min(vh) AS min_vh FROM ( SELECT properties.$session_id AS sid, argMin(properties.$device_type, timestamp) AS device, argMin(toInt(properties.$viewport_width), timestamp) AS vw, argMin(toInt(properties.$viewport_height), timestamp) AS vh, if(coalesce(any(session.$entry_utm_medium),'') = 'paid' OR (coalesce(any(session.$entry_fbclid),'') != '' AND coalesce(any(session.$entry_utm_source),'') = ''), 1, 0) AS paid, any(session.$entry_referring_domain) AS ref, max(properties.$virt_is_bot = true) AS is_bot FROM events WHERE event = '$pageview' AND timestamp >= toDateTime('2026-09-19 00:00:00') AND timestamp < toDateTime('2026-10-11 00:00:00') GROUP BY sid HAVING is_bot = 0 AND device IN ('Mobile','Tablet') AND NOT (coalesce(ref,'') IN ('localhost:3456','127.0.0.1:3456') OR coalesce(ref,'') LIKE '%vercel.app') ) GROUP BY device, vw ORDER BY device, sessions DESC LIMIT 40",
