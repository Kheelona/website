    {
      "id": "Q31",
      "what": "Paid sessions per day in PostHog (bots excluded)",
      "hogql": "SELECT toDate(st) AS day, countIf(um = 'paid') AS paid_tagged_sessions, countIf(fbc != '' AND us = '') AS meta_click_untagged_sessions, countIf(um = 'paid' OR (fbc != '' AND us = '')) AS paid_total, countIf((um = 'paid' OR (fbc != '' AND us = '')) AND webview = 'WhatsApp') AS paid_in_whatsapp FROM ( SELECT properties.$session_id AS sid, min(timestamp) AS st, coalesce(any(session.$entry_utm_source),'') AS us, coalesce(any(session.$entry_utm_medium),'') AS um, coalesce(any(session.$entry_fbclid),'') AS fbc, coalesce(argMin(properties.$webview_app, timestamp),'') AS webview, max(properties.$virt_is_bot = true) AS is_bot FROM events WHERE event = '$pageview' AND timestamp >= toDateTime('2026-09-19 00:00:00') AND timestamp < toDateTime('2026-09-25 00:00:00') GROUP BY sid HAVING is_bot = 0 ) GROUP BY day ORDER BY day",
      "range": "2026-09-19 00:00 to 2026-09-25 00:00 UTC",
