{
  "name": "kheelona-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/run-steps.mjs predev",
    "dev": "next dev",
    "prebuild": "node scripts/run-steps.mjs prebuild",
    "build": "next build",
    "postbuild": "node scripts/run-steps.mjs postbuild",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guards": "vitest run test/guards",
    "jscpd": "jscpd && npm run --silent jscpd:new",
    "jscpd:new": "jscpd --ignore \"**/*.test.ts,**/*.test.tsx,**/*.stories.tsx,**/*.generated.*,src/styles/generated/**\" --threshold 100 --baseline-from-ref archive/pre-reset-2026-10-10 --fail-on-new-clones --reporters console",
    "ds:checksums": "node scripts/ds-checksums.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run jscpd && npm run ds:checksums",
    "verify:e2e": "npm run build && npm run build-storybook && playwright test",
    "test:e2e": "playwright test",
    "test:visual": "node test/e2e/support/run-spec.mjs visual-parity",
    "test:text": "node test/e2e/support/run-spec.mjs text-parity",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
    "assets:css": "node scripts/assets/build-ds-css.mjs",
    "assets:fonts": "node scripts/assets/build-fonts.mjs",
    "assets:compose": "node scripts/assets/build-compose-css.mjs",
    "assets:icons": "node scripts/assets/build-icons.mjs",
    "assets:og": "node scripts/assets/build-og.mjs",
    "assets:doodles": "node scripts/assets/build-doodles.mjs",
    "storybook": "node scripts/run-steps.mjs predev && storybook dev -p 6006",
    "build-storybook": "node scripts/run-steps.mjs predev && storybook build --quiet",
    "event-link": "node tools/store/event-link.mjs",
    "utm": "node tools/utm/build-link.mjs",
    "qa:sweep": "node tools/qa/sweep.mjs",
    "qa:shot": "node tools/qa/shot.mjs",
    "qa:text": "node tools/qa/text.mjs",
    "qa:axe": "node tools/qa/axe-run.mjs",
    "qa:payment": "node tools/qa/payment-probe.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.12",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.3.8",
    "posthog-js": "1.434.2",
    "posthog-node": "5.52.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "4.12.1",
    "chrome-launcher": "1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jscpd": "5.3.2",
    "jsdom": "^27.4.0",
    "lighthouse": "13.4.1",
    "sharp": "0.35.5",
    "storybook": "^10.6.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "jscpd": {
    "path": [
      "src"
    ],
    "format": [
      "typescript",
      "tsx",
      "css",
      "javascript"
    ],
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.stories.tsx",
      "**/*.generated.*",
      "src/styles/generated/**",
      "src/components/atoms/**",
      "src/components/molecules/**",
      "src/components/organisms/**",
      "src/components/templates/**",
      "src/components/vendor/**",
      "src/features/home/**",
      "src/styles/globals.css",
      "src/app/(site)/playos/**",
      "src/app/(site)/page.tsx",
      "src/app/(site)/contact/page.tsx",
      "src/app/(site)/safety/page.tsx",
      "src/app/(site)/setup/page.tsx",
      "src/app/store/e/**",
      "src/app/store/ideabaaz/page.tsx",
      "src/app/api/**",
      "src/lib/store/**",
      "src/lib/email/**",
      "src/features/preorder/lib/**",
      "src/lib/campaign.ts",
      "src/proxy.ts"
    ],
    "threshold": 1,
    "reporters": [
      "console"
    ]
  }
}
